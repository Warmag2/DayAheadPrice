@using Faemiyah.DayAheadPrice.Components.Elements
@using Faemiyah.DayAheadPrice.Entities
@using Faemiyah.DayAheadPrice.Enums
@using Faemiyah.DayAheadPrice.Extensions
@using Faemiyah.DayAheadPrice.Logic
@using static Faemiyah.DayAheadPrice.Logic.GridScaleSelector
@implements IAsyncDisposable
@inject PriceIngestionService _ingestion
@inject PriceSeriesService _priceSeriesService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject TimeZoneInfo _timeZone
@inject TimeProvider _timeProvider

<div class="fullwidth page explorer" data-theme="@Theme">
    <div class="explorertopbar">
        <div class="explorercontrols">
            <button type="button" class="explorerbutton ctl-up" disabled=@(_view?.CanZoomIn != true) @onclick="ZoomIn" title="Zoom in">&#9650;</button>
            <button type="button" class="explorerbutton ctl-left" disabled=@(_view?.CanPanLeft != true) @onclick="PanLeft" title="Back in time">&#9664;</button>
            <button type="button" class="explorerbutton ctl-down" disabled=@(_view?.CanZoomOut != true) @onclick="ZoomOut" title="Zoom out">&#9660;</button>
            <button type="button" class="explorerbutton ctl-right" disabled=@(_view?.CanPanRight != true) @onclick="PanRight" title="Forward in time">&#9654;</button>
        </div>

        <div class="explorerheaders">
            <div id="TimeHeader" class="pageheader">
                @_timeString
            </div>

            <div id="PriceHeader" class="pageheader">
                @_priceString
            </div>
        </div>
    </div>

    @if (_view != null && _view.HasData)
    {
        <div class="fullwidth pagecontent">
            <Histogram Max=@_ceilPrice Min=@_floorPrice GridScale=@_gridScale Prices=@_adjustedPrices Resolution=@_view.Resolution HeaderUnit=@_view.HeaderUnit />
        </div>
    }
    else
    {
        <p class="fetchwarning">
            No stored prices to display yet.
        </p>
    }
</div>

@code {
    /// <summary>The zoom level index, from the "z" query parameter; <b>null</b> means the finest (live) level.</summary>
    [Parameter]
    public int? Zoom { get; set; }

    /// <summary>The window anchor as UTC ticks, from the "a" query parameter; <b>null</b> means the live view.</summary>
    [Parameter]
    public long? Anchor { get; set; }

    /// <summary>The colour theme ("light" or "dark").</summary>
    [Parameter]
    public string? Theme { get; set; }

    /// <summary>The operator margin applied to raw prices (c/kWh).</summary>
    [Parameter]
    public decimal Margin { get; set; }

    /// <summary>The VAT multiplier applied to raw prices (0.255 => 25.5%).</summary>
    [Parameter]
    public decimal Vat { get; set; }

    // Navigation re-enters OnParametersSetAsync without waiting for the previous render, so a slow render (one filling
    // a gap from the API) could finish last and overwrite a newer view. Only the latest render may show its result.
    private int _renderGeneration;
    private DotNetObjectReference<PriceExplorer>? _selfRef;
    private PriceView? _view;
    private SortedList<DateTime, decimal?> _adjustedPrices = [];
    private decimal _ceilPrice;
    private decimal _floorPrice;
    private decimal _gridScale;

    private string _timeString = string.Empty;
    private string _priceString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await _ingestion.EnsureFreshAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RenderStateAsync(CurrentState());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await _js.InvokeVoidAsync("dapExplorer.register", _selfRef);
        }

        // Re-assert the headers after every view change so they show the first visible bar rather than staying on
        // whatever bar was last hovered (hovering mutates the header DOM directly, out of Blazor's knowledge).
        await _js.InvokeVoidAsync("setPriceData", _priceString, _timeString);
    }

    /// <summary>
    /// Handle a navigation key forwarded from the document-level JavaScript listener.
    /// </summary>
    /// <param name="key">The pressed key.</param>
    [JSInvokable]
    public async Task HandleKey(string key)
    {
        switch (key)
        {
            case "ArrowLeft":
                PanLeft();
                break;
            case "ArrowRight":
                PanRight();
                break;
            case "ArrowUp":
                ZoomIn();
                break;
            case "ArrowDown":
                ZoomOut();
                break;
            case "End":
                await GoLiveAsync();
                break;
        }
    }

    /// <summary>
    /// Translate the incoming query parameters into a navigation state. An invalid or missing zoom falls back to the
    /// finest level, and a missing anchor means the live view.
    /// </summary>
    private PriceViewState CurrentState()
    {
        var zoom = Zoom is int z && z >= ZoomLevels.FinestIndex && z <= ZoomLevels.CoarsestIndex
            ? z
            : ZoomLevels.FinestIndex;

        DateTime? anchor = Anchor is long ticks && ticks >= DateTime.MinValue.Ticks && ticks <= DateTime.MaxValue.Ticks
            ? new DateTime(ticks, DateTimeKind.Utc)
            : null;

        return new PriceViewState(zoom, anchor);
    }

    private void PanLeft()
    {
        if (_view is { CanPanLeft: true })
        {
            Navigate(PriceNavigation.PanLeft(_view, _timeZone));
        }
    }

    private void PanRight()
    {
        if (_view is { CanPanRight: true })
        {
            Navigate(PriceNavigation.PanRight(_view, _timeZone, _timeProvider.GetUtcNow().UtcDateTime));
        }
    }

    private void ZoomIn()
    {
        if (_view is { CanZoomIn: true })
        {
            Navigate(PriceNavigation.ZoomIn(_view));
        }
    }

    private void ZoomOut()
    {
        if (_view is { CanZoomOut: true })
        {
            Navigate(PriceNavigation.ZoomOut(_view));
        }
    }

    private async Task GoLiveAsync()
    {
        if (_view is { IsLive: false })
        {
            Navigate(PriceViewState.Live);

            return;
        }

        // Already live, so the URL would not change: re-render in place, which also picks up newly published prices
        // in a tab left open since before they were published.
        await RenderStateAsync(PriceViewState.Live);
        StateHasChanged();
    }

    /// <summary>
    /// Push the given navigation state into the URL. The route's query parameters flow back in as new component
    /// parameters, which re-renders the view. The current history entry is replaced so panning does not fill the
    /// browser back-stack.
    /// </summary>
    private void Navigate(PriceViewState state)
    {
        var uri = _navigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["z"] = state.IsLive ? null : state.ZoomIndex,
            ["a"] = state.AnchorUtc.HasValue ? state.AnchorUtc.Value.Ticks : (long?)null
        });

        _navigationManager.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private async Task RenderStateAsync(PriceViewState state)
    {
        var generation = ++_renderGeneration;

        // A tab can stay open across a price publication, so every live render re-checks freshness. This is cheap: an
        // in-memory check, and at most one database query per hour.
        if (state.IsLive)
        {
            await _ingestion.EnsureFreshAsync();
        }

        var view = await _priceSeriesService.RenderAsync(state);

        if (generation != _renderGeneration)
        {
            return;
        }

        _view = view;

        _adjustedPrices = [];

        foreach (var (time, price) in _view.Bars)
        {
            _adjustedPrices.Add(time, price?.ApplyMarginAndVat(Margin, Vat));
        }

        if (_adjustedPrices.Count > 0)
        {
            // Unavailable bars are drawn full height whatever the scale, so only priced bars shape the axis.
            (_ceilPrice, _floorPrice, _gridScale) = GetAxis(_adjustedPrices.Values);
        }

        // Reset the headers so a view change immediately shows where we are, instead of whatever bar happened to be
        // hovered before: the current quarter in the live view, otherwise the first visible bar. When there is no such
        // bar, show the whole window.
        if (FindHeaderBar() is { } shown)
        {
            _priceString = shown.Value.FormatPrice();
            _timeString = DateTimeExtensions.DescribeSpan(shown.Key, _view.Resolution.AddTo(shown.Key, _timeZone), _timeZone);
        }
        else
        {
            _priceString = string.Empty;
            _timeString = DateTimeExtensions.DescribeSpan(_view.FromUtc, _view.ToUtc, _timeZone);
        }
    }

    /// <summary>
    /// Pick the bar the headers describe after a view change.
    /// </summary>
    /// <returns>The current quarter's bar in the live view, otherwise the first bar; <b>null</b> when there is none.</returns>
    private KeyValuePair<DateTime, decimal?>? FindHeaderBar()
    {
        if (_view is not { IsLive: true })
        {
            return _adjustedPrices.Count > 0 ? _adjustedPrices.First() : null;
        }

        var nowQuarterUtc = _timeProvider.GetUtcNow().UtcDateTime.FloorLocal(CalendarUnit.Quarter, _timeZone);

        return _adjustedPrices.TryGetValue(nowQuarterUtc, out var nowPrice) ? new(nowQuarterUtc, nowPrice) : null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_selfRef != null)
        {
            try
            {
                await _js.InvokeVoidAsync("dapExplorer.unregister");
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; nothing to clean up on the client.
            }

            _selfRef.Dispose();
        }
    }
}
