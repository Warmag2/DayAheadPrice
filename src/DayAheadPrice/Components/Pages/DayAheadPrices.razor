@using Faemiyah.DayAheadPrice.Options
@using Microsoft.Extensions.Options
@inject IOptions<PricingOptions> _pricingOptions
@inject IOptions<EndpointOptions> _endpointOptions
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@Title</PageTitle>

@* The interactive explorer owns the page and drives its zoom/pan position through the "z" and "a" query
   parameters supplied to this route. *@
<PriceExplorer Zoom="Zoom" Anchor="Anchor" Theme="@ResolvedTheme" Margin="ResolvedMargin" Vat="ResolvedVat" />

@code {
    [SupplyParameterFromQuery(Name = "z")]
    public int? Zoom { get; set; }

    [SupplyParameterFromQuery(Name = "a")]
    public long? Anchor { get; set; }

    [SupplyParameterFromQuery(Name = "theme")]
    public string? Theme { get; set; }

    [SupplyParameterFromQuery(Name = "margin")]
    public decimal? Margin { get; set; }

    [SupplyParameterFromQuery(Name = "vat")]
    public decimal? Vat { get; set; }

    private string ResolvedTheme => Components.Theme.Resolve(Theme);

    private string Title => string.IsNullOrWhiteSpace(_endpointOptions.Value.RegionDisplayName)
        ? "Day-ahead electricity prices"
        : $"Day-ahead electricity prices ({_endpointOptions.Value.RegionDisplayName})";

    // Out-of-range values (for example a negative VAT, which would zero every price) fall back to the defaults.
    private decimal ResolvedMargin => Margin is { } margin && PricingOptions.IsValidMargin(margin) ? margin : _pricingOptions.Value.Margin;
    private decimal ResolvedVat => Vat is { } vat && PricingOptions.IsValidVat(vat) ? vat : _pricingOptions.Value.Vat;
}
