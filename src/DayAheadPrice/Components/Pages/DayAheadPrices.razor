@using DayAheadPrice.Components.Elements
@using DayAheadPrice.Entities
@using DayAheadPrice.Extensions
@using DayAheadPrice.Logic
@using DayAheadPrice.Options
@using Microsoft.Extensions.Options
@using static DayAheadPrice.Logic.GridScaleSelector
@inject PriceContainer _priceContainer
@inject IOptions<PricingOptions> _pricingOptions
@inject NavigationManager _navigationManager
@page "/"
@* InteractiveServer is not needed for this page. All mouse/touch event handlers call
   a plain JavaScript function (setPriceData) via an inline string attribute, so no
   Blazor circuit is required to handle them. Removing InteractiveServer means the page
   is rendered once on the server and sent as static HTML — no persistent SignalR
   WebSocket connection is kept open per visitor, which saves ~250KB+ of server-side
   circuit memory per connected user.
@rendermode InteractiveServer *@

<PageTitle>Day-ahead electricity prices (Finland)</PageTitle>

@{
    var prices = _priceList?.GetPrices(_margin, _vat);
}

<script>
    function setPriceData(_, priceString, timeString) {
        document.getElementById("TimeHeader").innerHTML = timeString;
        document.getElementById("PriceHeader").innerHTML = priceString;
    }
</script>

<div class="fullwidth page" data-theme="@_theme">
    <div id="TimeHeader" class="pageheader">
        @_timeString
    </div>

    <div id="PriceHeader" class="pageheader">
        @_priceString
    </div>

    @if (prices != null && prices.Any())
    {
        @* The fetch failed but the cached prices still cover future time, so show them with a warning. *@
        @if (_fetchStatus != PriceFetchStatus.Success)
        {
            <p class="fetchwarning">
                @GetStatusMessage() Showing the most recently fetched prices.
            </p>
        }

        var maxPrice = prices.Max(p => p.Value);
        var minPrice = prices.Min(p => p.Value);
        minPrice = Math.Min(minPrice, 0.0m);
        var gridScale = GetGridScale((int)Math.Ceiling(maxPrice), (int)Math.Floor(minPrice));
        var ceilPrice = (int)Math.Ceiling(maxPrice / gridScale) * gridScale;
        var floorPrice = (int)Math.Floor(minPrice / gridScale) * gridScale;

        <div class="fullwidth pagecontent">
            <Histogram Max=@ceilPrice Min=@floorPrice Prices=@prices />
        </div>
    }
    else
    {
        <p>
            @GetStatusMessage()
        </p>
    }
</div>

@code {
    private PriceList? _priceList = null;
    private PriceFetchStatus _fetchStatus = PriceFetchStatus.Success;
    private string _theme = "dark";
    private decimal _margin;
    private decimal _vat;

    private string _timeString = string.Empty;
    private string _priceString = string.Empty;

    private string GetStatusMessage()
    {
        return _fetchStatus switch
        {
            PriceFetchStatus.ApiUnavailable => "The ENTSO-E price service is currently unavailable.",
            PriceFetchStatus.ApiNotFound => "The price service address returned \"not found\". API address is likely wrong.",
            PriceFetchStatus.Unreachable => "The price service could not be reached. Check the network connection.",
            PriceFetchStatus.NoDataForPeriod => "The price service returned no prices for this period. Check price area configuration.",
            PriceFetchStatus.InvalidResponse => "The price service returned data in an unexpected format. Check data formatting.",
            PriceFetchStatus.UnknownError => "Prices could not be loaded because of an unexpected error.",
            _ => "No data to display."
        };
    }

    private void SetPriceString(decimal input)
    {
        _priceString = $"{input.ToString("0.00")}c/kWh";
    }

    private void SetTimeString(DateTime input)
    {
        _timeString = $"{input.Month.ToString("00")}-{input.Day.ToString("00")} \u23F2 {input.Hour.ToString("00")}:{input.Minute.ToString("00")} \u2014 {(input.Hour).ToString("00")}:{(input.Minute + 14).ToString("00")}";
    }

    protected override async Task OnInitializedAsync()
    {
        if (_navigationManager.TryGetQueryString<string>("theme", out var theme)
            && (theme == "light" || theme == "dark"))
        {
            _theme = theme;
        }

        if (_navigationManager.TryGetQueryString<decimal>("margin", out var margin))
        {
            _margin = margin;
        }
        else
        {
            _margin = _pricingOptions.Value.Margin;
        }

        if (_navigationManager.TryGetQueryString<decimal>("vat", out var vat))
        {
            _vat = vat;
        }
        else
        {
            _vat = _pricingOptions.Value.Vat;
        }

        var fetchResult = await _priceContainer.GetPriceListAsync();

        _priceList = fetchResult.Prices;
        _fetchStatus = fetchResult.Status;

        if (_priceList != null)
        {
            var prices = _priceList.GetPrices(_margin, _vat);
            var printValue = prices?.TryGetValue(DateTime.Now.Floor(FloorResolution.Quarter), out var value) == true ? value : 0m;
            SetPriceString(printValue);
            SetTimeString(DateTime.Now.Floor(FloorResolution.Quarter));
        }
    }
}
