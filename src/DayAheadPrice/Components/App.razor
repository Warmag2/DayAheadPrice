<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="./dayaheadprice.css" />
    <link rel="stylesheet" href="./DayAheadPrice.styles.css" />
    <link rel="icon" type="image/png" href="favicon_faemiyah.png" />
    <meta property="og:site_name" content="DayAheadPrice" />
    <meta property="og:title" content="DayAheadPrice" />
    <meta property="og:description" content="Day-ahead electricity spot prices from ENTSO-E." />
    <meta property="og:image" content="@OgImageUrl" />
    <meta property="og:type" content="website" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="explorer.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext HttpContext { get; set; } = default!;

    // Open Graph requires an absolute URL; derived from the request so it follows whatever host the app is served on.
    private string OgImageUrl =>
        $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{HttpContext.Request.PathBase}/logo_dayaheadprice.png";
}
