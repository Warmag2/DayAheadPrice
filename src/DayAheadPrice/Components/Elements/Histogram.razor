@using Faemiyah.DayAheadPrice.Enums
@using Faemiyah.DayAheadPrice.Extensions
@using Faemiyah.DayAheadPrice.Logic
@inject TimeZoneInfo _timeZone
@inject TimeProvider _timeProvider

@{
    var gridHeightPercent = GridScale * 100 / (Max - Min);
    var gridStyle = $"--grid-h: {gridHeightPercent.ToCss()}%";
    var nowUtc = _timeProvider.GetUtcNow().UtcDateTime;
    var today = nowUtc.ToLocalWall(_timeZone).Date;
}

<div class="histogramblock">
    <div class="gridhost histogramheader">
        <div class="fullwidth gridnumber">
            c€
        </div>
    </div>
    <div class="histogramcontent" style=@gridStyle>
        <HistogramAxis Max=@Max GridScale=@GridScale GridHeightPercent=@gridHeightPercent />
    </div>
</div>

@foreach (var priceGroup in Prices.GroupBy(p => p.Key.FloorLocal(HeaderUnit, _timeZone)))
{
    var groupEnd = new CalendarStep(HeaderUnit, 1).AddTo(priceGroup.Key, _timeZone);
    var currentGroup = priceGroup.Key <= nowUtc && nowUtc < groupEnd;
    var currentDay = HeaderUnit != CalendarUnit.Month && priceGroup.Key.ToLocalWall(_timeZone).Date == today && !currentGroup;

    List<string> backgroundClasses = [];

    if (currentDay)
    {
        backgroundClasses.Add("currentday");
    }

    if (currentGroup)
    {
        backgroundClasses.Add("currentgroup");
    }

    <div class="histogramblock leftborder">
        <div class=@(string.Join(' ', backgroundClasses.Concat(["gridhost", "histogramheader"])))>
            <div class="fullwidth gridnumber">
                @GroupLabel(priceGroup.Key)
            </div>
        </div>
        <div class=@(string.Join(' ', backgroundClasses.Concat(["histogramcontent"]))) style=@gridStyle>
            @foreach (var (time, price) in priceGroup)
            {
                <HistogramBar Max=@Max Min=@Min Price=@price Time=@time End=@(Resolution.AddTo(time, _timeZone)) />
            }
        </div>
    </div>
}

@code {
    /// <summary>The axis top, from <see cref="GridScaleSelector.GetAxis"/>.</summary>
    [Parameter]
    public decimal Max { get; set; }

    /// <summary>The axis bottom (never above zero), from <see cref="GridScaleSelector.GetAxis"/>.</summary>
    [Parameter]
    public decimal Min { get; set; }

    /// <summary>The grid step the axis was rounded to, from <see cref="GridScaleSelector.GetAxis"/>.</summary>
    [Parameter]
    public decimal GridScale { get; set; }

    /// <summary>
    /// The bars, keyed by UTC slot start.
    /// </summary>
    [Parameter]
    public SortedList<DateTime, decimal?> Prices { get; set; } = [];

    /// <summary>
    /// The width of one bar.
    /// </summary>
    [Parameter]
    public CalendarStep Resolution { get; set; } = new(CalendarUnit.Quarter, 1);

    /// <summary>
    /// The unit bars are grouped under for column headers.
    /// </summary>
    [Parameter]
    public CalendarUnit HeaderUnit { get; set; } = CalendarUnit.Hour;

    private string GroupLabel(DateTime groupStartUtc)
    {
        var groupStart = groupStartUtc.ToLocalWall(_timeZone);

        return HeaderUnit switch
        {
            CalendarUnit.Year => groupStart.Year.ToString(),
            CalendarUnit.Month => groupStart.Month.ToString("00"),
            CalendarUnit.Day => groupStart.Day.ToString("00"),
            _ => groupStart.Hour.ToString()
        };
    }
}