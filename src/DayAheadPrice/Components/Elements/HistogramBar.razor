@using Faemiyah.DayAheadPrice.Extensions
@inject TimeZoneInfo _timeZone

@{
    var price = Price ?? 0m;
    var barHeightPercent = 100 * price / (Max - Min); // May be negative
    var barVisible = price != 0;
}

<div class="histogrambar" data-price=@Price.FormatPrice() data-time=@GetTimeString()>
    @if (Price == null)
    {
        <div class="unavailable" style="flex:1" />
    }
    else if (barHeightPercent >= 0)
    {
        <div class="noprice" style=@($"flex:{(100*(Max-price)/(Max-Min)).ToCss()}") />
        @if (barVisible)
        {
            <div class="price" style=@($"flex:{barHeightPercent.ToCss()}") />
        }
        @if (Min < 0)
        {
            <div class="noprice" style=@($"flex:{(100*(-Min)/(Max-Min)).ToCss()}") />
        }
    }
    else
    {
        @if (Max > 0)
        {
            <div class="noprice" style=@($"flex:{(100*Max/(Max-Min)).ToCss()}") />
        }
        <div class="price" style=@($"flex:{(-barHeightPercent).ToCss()}") />
        <div class="noprice" style=@($"flex:{(100*(price-Min)/(Max-Min)).ToCss()}") />
    }
</div>

@code {
    [Parameter]
    public decimal Max { get; set; }

    [Parameter]
    public decimal Min { get; set; }

    /// <summary>
    /// The bar's price; <b>null</b> when the price is unavailable.
    /// </summary>
    [Parameter]
    public decimal? Price { get; set; }

    /// <summary>
    /// The inclusive start of the bar's time slot, UTC.
    /// </summary>
    [Parameter]
    public DateTime Time { get; set; }

    /// <summary>
    /// The exclusive end of the bar's time slot, UTC, used for the hover tooltip.
    /// </summary>
    [Parameter]
    public DateTime End { get; set; }

    private string GetTimeString()
    {
        return DateTimeExtensions.DescribeSpan(Time, End, _timeZone);
    }
}