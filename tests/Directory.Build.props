<Project>

  <!-- Inherit the repository-wide settings, then override what does not apply to test projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFileName)$(MSBuildThisFileExtension), $(MSBuildThisFileDirectory)..\))" />

  <PropertyGroup>
    <!-- Test classes are not consumed as an API, so missing XML documentation is not worth warning about. The file is
         still generated, because the build only reports unused usings (IDE0005) when it is. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

</Project>
